{
  "name": "binance-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "pnpm --filter @binance/db build",
    "dev:admin": "pnpm --filter admin dev",
    "dev:page": "pnpm --filter page dev",
    "build:admin": "pnpm --filter @binance/db build && pnpm --filter admin build",
    "build:page": "pnpm --filter @binance/db build && pnpm --filter page build",
    "db:generate": "pnpm --filter @binance/db prisma:generate",
    "db:migrate": "pnpm --filter @binance/db prisma:migrate",
    "db:deploy": "pnpm --filter @binance/db prisma:deploy",
    "db:push": "pnpm --filter @binance/db prisma:push",
    "db:studio": "pnpm --filter @binance/db prisma:studio",
    "db:seed": "pnpm --filter @binance/db prisma:seed"
  }
}
